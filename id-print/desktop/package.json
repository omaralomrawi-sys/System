{
  "name": "id-print",
  "productName": "ID Print",
  "version": "1.0.0",
  "description": "ID document layout & print",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.idprint.app",
    "productName": "ID Print",
    "files": ["main.js", "preload.js", "app/**"],
    "win": { "target": "portable", "artifactName": "ID-Print.exe" }
  }
}
